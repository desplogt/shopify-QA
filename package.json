{
  "name": "theme-qa",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic release gate for Shopify themes: compares a pull request's theme against the live theme and blocks new defects.",
  "type": "module",
  "bin": {
    "theme-qa": "dist/cli.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "verify": "npm run typecheck && npm test && npm run build",
    "theme-qa": "tsx src/cli.ts"
  },
  "dependencies": {
    "playwright": "1.64.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
